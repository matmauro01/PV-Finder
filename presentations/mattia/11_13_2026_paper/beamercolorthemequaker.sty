% Derived from wolverine

\mode<presentation>

% \definecolor{pennblue}{RGB}{140,21,21}
\definecolor{pennblue}{RGB}{23,94,84}
\definecolor{stanfordgreendark}{RGB}{1,66,64}
\definecolor{stanfordgreenlight}{RGB}{45,113,111}
\definecolor{pennred}{RGB}{140,21,21}
\definecolor{penngold}{RGB}{242,193,0}
\definecolor{atlasblue}{RGB}{11,128,195}
\definecolor{stanfordgreen}{RGB}{23,94,84}

\setbeamercolor*{palette primary}{fg=white,bg=stanfordgreenlight}
\setbeamercolor*{palette secondary}{fg=white,bg=pennblue}
\setbeamercolor*{palette tertiary}{fg=white,bg=stanfordgreendark}
\setbeamercolor*{palette quaternary}{fg=white,bg=white}

\setbeamercolor{normal text}{fg=black, bg=white}
\setbeamercolor{alerted text}{fg=pennred}
\setbeamercolor{frametitle}{fg=white, bg=pennred}
\setbeamercolor{section in toc}{fg=pennblue, bg=white}
\setbeamercolor{title}{fg=white, bg=pennred}
\setbeamercolor{inverted normal text}{fg=white, bg=pennblue}
\setbeamercolor{item}{fg=pennred}
\setbeamercolor{itemize item}{fg=pennred}
\setbeamercolor{itemize subitem}{fg=pennred}
\setbeamercolor{itemize subsubitem}{fg=pennred}
\setbeamercolor{enumerate item}{fg=pennred}
\setbeamercolor{enumerate subitem}{fg=pennred}
\setbeamercolor{caption name}{fg=pennblue}
\setbeamercolor{block title}{fg=pennblue, bg=gray!30}
\setbeamercolor{block body}{bg=gray!10}
\setbeamercolor{block title alerted}{bg=gray!30}
\setbeamercolor{block body alerted}{bg=gray!10}

\setbeamercolor*{sidebar}{fg=pennred,bg=pennred!75!white}

\setbeamercolor*{palette sidebar primary}{fg=pennred!10!black}
\setbeamercolor*{palette sidebar secondary}{fg=white}
\setbeamercolor*{palette sidebar tertiary}{fg=pennred!50!black}
\setbeamercolor*{palette sidebar quaternary}{fg=white!10!pennred}

\setbeamercolor*{titlelike}{fg=black, bg=white}
%\setbeamercolor{frametitle}{fg=white,bg=pennred}
%\setbeamercolor{frametitle right}{bg=white!60!pennred}

%\setbeamercolor{footnote}{fg=blue}
\setbeamercolor{footnote mark}{fg=.} % This should allow hyperlink in title, don't know why it doesn't work

\setbeamercolor*{bibliography item}{parent=enumerate item}
\setbeamercolor*{bibliography entry author}{parent=normal text}
\setbeamercolor*{bibliography entry title}{parent=normal text}
\setbeamercolor*{bibliography entry location}{parent=normal text}
\setbeamercolor*{bibliography entry note}{parent=normal text}

\setbeamercolor*{separation line}{}
\setbeamercolor*{fine separation line}{}

\mode<all>
